# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env

# Uploaded call audio and model caches. Production-call audio is confidential
# (brief §5) and must never enter the repository.
data/cache/

# Validation run artifacts. These embed verbatim IEMOCAP reference
# transcripts (`ref_transcript` per sample) and full sweep logs. IEMOCAP is
# distributed under a restrictive USC licence that does not permit
# redistribution, so publishing these would be a licence breach as well as
# noise. The numbers that matter are quoted in TECHNICAL_MEMO.md and
# docs/findings.pdf; the raw runs stay local.
validation_results*.json
iter_*.json
predictions*.json
stage_timings.json
*.log
ablation_context/
ablation_override/

# Rasterized /findings page images, rebuilt on demand from docs/findings.pdf.
.run/findings_pages/

# LaTeX build artifacts for docs/findings.tex -- findings.pdf itself is
# tracked (the app serves it directly), these intermediates are not.
docs/*.aux
docs/*.out
docs/*.fls
docs/*.fdb_latexmk
docs/*.synctex.gz
docs/missfont.log

# Internal planning doc and AutoAce's brief (stamped "Confidential Technical
# Trial"). Neither belongs in a repo that gets handed back or shared -- kept
# on disk, out of git. Also purged from history, see git log.
PLAN.md
PROJECT_BRIEF.md
